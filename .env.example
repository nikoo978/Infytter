# GymFlow / Infytter Fitness - entorno portable para Docker/Coolify.
# Copiar los valores reales a Coolify > Environment Variables. No commitear secretos.

# Runtime HTTP
HOST=0.0.0.0
PORT=3000
MAX_BODY_BYTES=1048576

# URL pública HTTPS oficial
PUBLIC_APP_URL=https://infytter.coffeetec.com.ar

# Supabase público (build-time para Vite y runtime para API)
VITE_SUPABASE_URL=https://ubfqwmhxkjtqdcfnsmwe.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_URL=https://ubfqwmhxkjtqdcfnsmwe.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
REDIS_STATE_KEY=gymflow

# QStash. Copiar URL + token de la MISMA región desde Upstash Console.
# EU: https://qstash-eu-central-1.upstash.io (también https://qstash.upstash.io)
# US: https://qstash-us-east-1.upstash.io
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=replace-me
NOTIFICATION_SECRET=replace-with-a-long-random-secret

# Web Push
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com
